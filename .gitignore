# Byte-compiled / cache files
__pycache__/
*.pyc

# Virtual environments
venv/
.venv/
env/

# data/ and output/ generated files are intentionally committed (see README)
# so the repo is browsable/runnable without a `python run_pipeline.py` step first.
# .gitkeep entries are harmless no-ops now but kept in case these ever go back
# to being ignored.
!data/.gitkeep
!output/.gitkeep

# Streamlit local config
.streamlit/

# OS / editor junk
.DS_Store
.idea/
.vscode/

# Local run logs / pytest cache
pipeline_run.log
.pytest_cache/
